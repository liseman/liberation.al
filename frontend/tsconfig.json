{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@pascal-app/editor": ["./src/plan-editor/pascal-editor.d.ts"],
      "@pascal-app/editor/locales": ["./src/plan-editor/pascal-editor.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.pascal.ts", "vite.plan-editor.config.ts"]
}
